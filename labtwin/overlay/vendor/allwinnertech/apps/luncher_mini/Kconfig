config LUNCHER_MINI_APP
	bool "luncher mini app"
	default n

	---help---
		Enable luncher mini app.


if LUNCHER_MINI_APP

config LUNCHER_MINI_APP_PROGNAME
	string "Program name"
	default "luncher_mini"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config LUNCHER_MINI_APP_PRIORITY
	int "luncher_mini task priority"
	default 100

config LUNCHER_MINI_APP_STACKSIZE
	int "luncher_mini stack size"
	default 102400

config LUNCHER_MINI_SETTINGS
	bool "Embedded device settings"
	default n
	depends on AI_AGENT_DEVICE_SETTINGS
	---help---
		Embed Wi-Fi, BLE peripheral and BLE NUS provisioning pages into
		luncher_mini.  The launcher remains the sole LVGL, LCD and touch
		owner; do not start mini_memo alongside it.

config LUNCHER_MINI_LAB_UI
	bool "LabTwin experiment dashboard"
	default y
	---help---
		Replace the example launcher tiles with the 320x240 LabTwin
		experiment dashboard.  The same lab_ui sources are used by the
		Windows SDL desktop preview and the Gemini-S1 firmware.

endif
